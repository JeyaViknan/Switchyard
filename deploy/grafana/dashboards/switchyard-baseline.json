{
  "title": "Switchyard - Baseline",
  "uid": "switchyard-baseline",
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "timeseries", "title": "Throughput by outcome (req/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "sum by (outcome) (rate(switchyard_requests_total[30s]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "type": "timeseries", "title": "End-to-end latency percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(switchyard_request_duration_seconds_bucket[1m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(switchyard_request_duration_seconds_bucket[1m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(switchyard_request_duration_seconds_bucket[1m])))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries", "title": "Time to first token",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, provider) (rate(switchyard_ttft_seconds_bucket[1m])))", "legendFormat": "p50 {{provider}}"},
        {"expr": "histogram_quantile(0.99, sum by (le, provider) (rate(switchyard_ttft_seconds_bucket[1m])))", "legendFormat": "p99 {{provider}}"}
      ]
    },
    {
      "type": "timeseries", "title": "Gateway overhead (total minus provider time)",
      "description": "The latency Switchyard is responsible for. Everything else is the provider.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(switchyard_gateway_overhead_seconds_bucket[1m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(switchyard_gateway_overhead_seconds_bucket[1m])))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries", "title": "Event loop lag",
      "description": "In an asyncio gateway this is the first place CPU-bound work on the loop shows up. If p99 here tracks p99 request latency, the bottleneck is Switchyard, not the provider.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(switchyard_event_loop_lag_seconds_bucket[1m])))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries", "title": "In-flight requests by provider",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "switchyard_inflight", "legendFormat": "{{provider}}"}]
    }
  ]
}
